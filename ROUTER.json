{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Holo UI Vault — AI Agent Context-Efficient Router",
  "version": "1.0.0",
  "description": "极简快速分发路由表。供 AI Agent 在 1 次读取内完成精准定位，杜绝全库扫描与上下文膨胀。",
  "context_guards": {
    "anti_over_assembly_guide": "STYLE_AND_SELECTION_GUIDE.md (选型前必读：防过度组装天条与风格象限)",
    "strict_rules": [
      "🛑 严禁过度组装：单一输入框需求绝不堆砌复合聊天窗，无推理需求绝不强塞 thinking-state",
      "🛑 严禁风格混搭：Apple 圆角毛玻璃绝不与 Beautiful UI 冷色虚线发丝边框杂糅",
      "🛑 严禁读取 beautifului-components/index.html（32KB 人类画廊页面，严重浪费上下文且对代码集成无用）",
      "🛑 严禁对仓库进行递归目录扫描或全量读取所有 markdown 文件",
      "🎯 单次任务应只定点读取：1 个目标 snippet.html + 对应 shared/base.css（如需）",
      "🎯 设计知识需求应只定点读取：PROMPT_PRESET.md 或对应单个 foundation 文档"
    ]
  },
  "intent_dispatch": [
    {
      "intent": "ai_agent_ui_components",
      "keywords": ["ai states", "thinking", "loading", "streaming", "approval", "prompt bar", "chat", "chips", "table"],
      "library": "beautifului-components",
      "direct_entry": "beautifului-components/catalog.json",
      "shared_style": "beautifului-components/shared/base.css",
      "recommended_action": "直接从下面的 component_lookup 查取单个 snippet 路径，勿读 index.html"
    },
    {
      "intent": "apple_style_generation",
      "keywords": ["apple style", "ios style", "hig", "mac style", "liquid glass", "squircle", "44pt", "苹果风格"],
      "library": "guidelines/apple-design",
      "rules_prompt": "guidelines/apple-design/PROMPT_PRESET.md",
      "css_tokens": "guidelines/apple-design/tokens/tokens.css",
      "recommended_action": "写代码时只读取 PROMPT_PRESET.md 或 tokens.css，勿全量读取 foundations 与 resources"
    },
    {
      "intent": "apple_design_knowledge_lookup",
      "keywords": ["typography scale", "materials blur", "spring physics", "modal sheet rules", "figma download"],
      "sub_routes": {
        "typography": "guidelines/apple-design/foundations/typography.md",
        "materials_blur": "guidelines/apple-design/foundations/materials-and-vibrancy.md",
        "layout_touch": "guidelines/apple-design/foundations/layout-and-touch.md",
        "motion_spring": "guidelines/apple-design/foundations/motion-and-spring.md",
        "modals_sheets": "guidelines/apple-design/patterns/modals-and-sheets.md",
        "official_downloads": "guidelines/apple-design/resources/official-downloads.md",
        "wwdc_videos": "guidelines/apple-design/resources/wwdc-design-videos.md",
        "hig_component_index": "guidelines/apple-design/resources/hig-component-index.md"
      }
    }
  ],
  "component_lookup": {
    "loading-state": "beautifului-components/components/ai-states/loading-state.snippet.html",
    "thinking-state": "beautifului-components/components/ai-states/thinking-state.snippet.html",
    "streaming-text": "beautifului-components/components/ai-states/streaming-text.snippet.html",
    "approval-card": "beautifului-components/components/interaction/approval-card.snippet.html",
    "tool-chips": "beautifului-components/components/interaction/tool-chips.snippet.html",
    "selection-actions": "beautifului-components/components/interaction/selection-actions.snippet.html",
    "task-rows": "beautifului-components/components/task-management/task-rows.snippet.html",
    "chat-composer": "beautifului-components/components/input/chat-composer.snippet.html",
    "prompt-bar": "beautifului-components/components/input/prompt-bar.snippet.html",
    "search": "beautifului-components/components/input/search.snippet.html",
    "recommendation-card": "beautifului-components/components/cards/recommendation-card.snippet.html",
    "context-cards": "beautifului-components/components/cards/context-cards.snippet.html",
    "insight-cards": "beautifului-components/components/cards/insight-cards.snippet.html",
    "fine-tune-card": "beautifului-components/components/cards/fine-tune-card.snippet.html",
    "diff-table": "beautifului-components/components/data/diff-table.snippet.html",
    "records-table": "beautifului-components/components/data/records-table.snippet.html",
    "filter-table": "beautifului-components/components/data/filter-table.snippet.html",
    "sidebar-nav": "beautifului-components/components/navigation/sidebar-nav.snippet.html",
    "flowchart": "beautifului-components/components/visualization/flowchart.snippet.html",
    "code-block": "beautifului-components/components/code/code-block.snippet.html",
    "agent-screen": "beautifului-components/components/layout/agent-screen.snippet.html"
  }
}
