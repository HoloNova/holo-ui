    "ai_native_productivity": {
      "desc": "Cold neutral, dark-first, high information density, 0.5px hairlines, tabular figures, subtle shimmer transitions.",
      "manifest": "beautifului-components/beautifului.manifest.json",
      "design_md": "beautifului-components/DESIGN.md",
      "shared_css": "beautifului-components/shared/base.css"
    },
    "apple_human_interface": {
      "desc": "Humanist, tactile spatial depth, continuous squircle curvature, liquid glass blur, spring physics, 44pt touch friendliness.",
      "manifest": "guidelines/apple-design/apple-design.manifest.json",
      "design_md": "guidelines/apple-design/DESIGN.md",
      "tokens_css": "guidelines/apple-design/tokens/tokens.css"
    },
    "kinetic_motion_tactile": {
      "desc": "Physical spring damping, continuous fluid morphing, 3D orbital rotations, kinetic typography, Lilac & Orange accent palette.",
      "manifest": "rewampui-components/rewampui.manifest.json",
      "design_md": "rewampui-components/DESIGN.md",
      "shared_css": "rewampui-components/shared/base.css",
      "tokens_css": "rewampui-components/shared/tokens.css"
    },
    "micro_motion_indicators": {
      "desc": "Minimalist, zero-runtime, pure CSS/SVG, hairline single strokes, 3x3 pixel matrices, and 3D quantum wireframes.",
      "manifest": "loadingdev-components/loadingdev.manifest.json",
      "design_md": "loadingdev-components/DESIGN.md",
      "shared_css": "loadingdev-components/shared/base.css"
    },
    "minimal_theme_toggles": {
      "desc": "Pure CSS/SVG, 1em vector morphing, zero-runtime, accessible, clip-path and path transitions, reduced-motion guards.",
      "manifest": "themetoggle-components/themetoggle.manifest.json",
      "design_md": "themetoggle-components/DESIGN.md",
      "shared_css": "themetoggle-components/shared/base.css"
    },
    "obsidian_tactile_showcase": {
      "desc": "Apple-style spring physics, expanding rounded corners, outward shift on hover, partner split cards, and dotted divider.",
      "manifest": "obsidianui-components/obsidianui.manifest.json",
      "design_md": "obsidianui-components/DESIGN.md",
      "shared_css": "obsidianui-components/shared/base.css"
    },
    "arc_motion_primitives": {
      "desc": "OKLCH color system, motion/react physics-based spring curves, useMorphWidth dynamic resize, and zero layout shift micro-interactions.",
      "manifest": "arc-components/arc.manifest.json",
      "design_md": "arc-components/DESIGN.md",
      "shared_css": "arc-components/shared/base.css"
    }
  },
